{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FistBump",
  "version": "0.2.4",
  "identifier": "com.fistbump.app",
  "build": {
    "frontendDist": "../app/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; worker-src 'self' blob:; frame-src blob:; object-src blob:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Fistbump",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icon.icns",
      "../build/icon.ico",
      "../build/icon.png"
    ],
    "category": "Productivity"
  }
}
