{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FistBump",
  "version": "0.2.4",
  "identifier": "com.fistbump.app",
  "build": {
    "frontendDist": "../app/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; worker-src 'self' blob:; frame-src blob:; object-src blob:"
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icon.icns",
      "../build/icon.ico",
      "../build/icon.png"
    ],
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
