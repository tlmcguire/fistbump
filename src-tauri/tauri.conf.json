{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FistBump",
  "version": "0.2.4",
  "identifier": "com.fistbump.desktop",
  "build": {
    "frontendDist": "../app/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; worker-src 'self' blob:; frame-src blob:; object-src blob:"
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "../build/icon.icns",
      "../build/icon.ico",
      "../build/icon.png"
    ],
    "category": "Productivity",
    "resources": {
      "resources/bin/": "bin/"
    },
    "macOS": {
      "dmg": {
        "background": "../build/background.tiff",
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 130,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 215
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "../build/icon.ico",
        "sidebarImage": "../build/installerSidebar.bmp",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RTNDMEU3MkZBNzMwRTEKUldUaE1LY3Y1OERqRmM4TDlURS9XTmpVOEFWZE1WOXcxeGIremNMdmZVeUVtZWdGN1R6cnpmS0cK",
      "endpoints": []
    }
  }
}
