{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Fistbump main and error windows",
  "windows": ["main", "error"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    "opener:default",
    "clipboard-manager:default"
  ]
}
